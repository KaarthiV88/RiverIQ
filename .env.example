# Groq (https://console.groq.com)
GROQ_API_KEY=

# Supabase (https://supabase.com → Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Settings → API → JWT Settings → JWT Secret (used to verify user session tokens)
SUPABASE_JWT_SECRET=

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOW_ORIGINS=http://localhost:3000

# Coach LLM (optional — sensible defaults in app/config.py).
# Override to swap models without a code change if a vendor retires one.
# GROQ_MODEL=openai/gpt-oss-120b
# Auto-used when the primary returns 404 (retired) or 429 (throttled).
# GROQ_FALLBACK_MODEL=groq/compound-mini
# Point at any OpenAI-compatible provider (Gemini, Cerebras, OpenRouter);
# set GROQ_API_KEY to that provider's key as well.
# GROQ_BASE_URL=
